--- /dev/null
+++ b/test/priority-queue-set-priority.ts
@@ -0,0 +1,23 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import PriorityQueue from '../source/priority-queue.js';
+
+const createRun = (value: string) => async () => value;
+
+test('PriorityQueue setPriority matches the requested id, not the first other id', () => {
+	const matchingQueue = new PriorityQueue();
+	const firstBackgroundRun = createRun('first');
+	const secondTargetRun = createRun('second');
+	const thirdBackgroundRun = createRun('third');
+
+	matchingQueue.enqueue(firstBackgroundRun, {id: 'first'});
+	matchingQueue.enqueue(secondTargetRun, {id: 'second'});
+	matchingQueue.enqueue(thirdBackgroundRun, {id: 'third'});
+
+	matchingQueue.setPriority('second', 1);
+
+	assert.deepEqual(
+		[matchingQueue.dequeue(), matchingQueue.dequeue(), matchingQueue.dequeue()],
+		[secondTargetRun, firstBackgroundRun, thirdBackgroundRun],
+	);
+});
