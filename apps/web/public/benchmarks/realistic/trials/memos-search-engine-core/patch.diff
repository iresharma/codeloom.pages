-  return (data.memos || []).map((memo: unknown) => Memo.fromPartial({ ...(memo as Memo), displayTime: (memo as Memo).displayTime ? new Date(String((memo as Memo).displayTime)) : undefined }));
+  return (data.memos || []).map((memo: unknown) =>
+    Memo.fromPartial({
+      ...(memo as Memo),
