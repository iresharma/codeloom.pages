+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "vite";
+import { fileURLToPath } from "node:url";
+
+let server;
+let mod;
+
+test("load reader module through Vite alias resolution", async () => {
+  const src = fileURLToPath(new URL("../", import.meta.url));
+  server = await createServer({
+    root: fileURLToPath(new URL("../../", import.meta.url)),
+    configFile: false,
+    resolve: {
+      alias: [{ find: "@", replacement: src }],
+    },
+  });
+  mod = await server.ssrLoadModule("/src/lib/reader.ts");
+  assert.ok(mod.selectMemos);
+  assert.ok(mod.summarizeMemo);
+  await server.close();
+});
+
+test("selectMemos filters q as case-insensitive substring", async () => {
+  const queryMemos = [
+    { name: "a", content: "Alpha release", tags: [] },
+    { name: "b", content: "Beta planning", tags: [] },
+  ];
+  assert.deepEqual(
+    mod.selectMemos(queryMemos, new URLSearchParams("q=RELEASE")).map((m) => m.name),
+    ["a"],
+  );
+});
+
+test("selectMemos filters tag as case-insensitive whole entry, no slash expansion", async () => {
+  const tagMemos = [
+    { name: "a", content: "Alpha release", tags: ["release"] },
+    { name: "b", content: "Nested", tags: ["release/1"] },
+  ];
+  assert.deepEqual(
+    mod.selectMemos(tagMemos, new URLSearchParams("tag=Release")).map((m) => m.name),
+    ["a"],
+  );
+  assert.deepEqual(
+    mod.selectMemos(tagMemos, new URLSearchParams("tag=release/1")).map((m) => m.name),
+    ["b"],
+  );
+});
+
+test("selectMemos combines query and tag with AND", async () => {
+  const combinedMemos = [
+    { name: "hit", content: "Alpha release", tags: ["release"] },
+    { name: "query-only", content: "Alpha release", tags: ["planning"] },
+    { name: "tag-only", content: "Beta planning", tags: ["release"] },
+  ];
+  assert.deepEqual(
+    mod.selectMemos(combinedMemos, new URLSearchParams("q=alpha&tag=release")).map((m) => m.name),
+    ["hit"],
+  );
+});
+
+test("summarizeMemo uses snippet and truncates to 200 when query is empty", () => {
+  const snippet200 = "s".repeat(250);
+  const snippetSummary = mod.summarizeMemo({ content: "content", snippet: snippet200 }, "");
+  assert.equal(snippetSummary.length, 201);
+  assert.ok(snippetSummary.startsWith(snippet200.slice(0, 200)));
+  assert.ok(snippetSummary.endsWith("…"));
+});
+
+test("summarizeMemo windows the first case-insensitive match", () => {
+  const windowContent = "p".repeat(100) + "Release notes" + "s".repeat(100);
+  const windowSummary = mod.summarizeMemo({ content: windowContent, snippet: "" }, "release");
+  assert.ok(windowSummary.includes("Release"));
+  assert.ok(windowSummary.startsWith("…"));
+  assert.ok(windowSummary.endsWith("…"));
+});
+
+test("summarizeMemo falls back to 200-char truncation when query is absent", () => {
+  const fallbackContent = "c".repeat(250);
+  const fallbackSummary = mod.summarizeMemo({ content: fallbackContent, snippet: "" }, "missing");
+  assert.equal(fallbackSummary.length, 201);
+  assert.ok(fallbackSummary.startsWith("c".repeat(200)));
+  assert.ok(fallbackSummary.endsWith("…"));
+});
+
+test("selectMemos returns all memos when both query and tag are empty", async () => {
+  const allMemos = [
+    { name: "a", content: "Alpha release", tags: ["release"] },
+    { name: "b", content: "Beta planning", tags: ["planning"] },
+  ];
+  assert.deepEqual(
+    mod.selectMemos(allMemos, new URLSearchParams("")).map((m) => m.name),
+    ["a", "b"],
+  );
+});
+
+test("selectMemos trims whitespace from query and tag params", async () => {
+  const memos = [
+    { name: "a", content: "Alpha release", tags: ["release"] },
+  ];
+  assert.deepEqual(
+    mod.selectMemos(memos, new URLSearchParams("q=%20%20alpha%20%20")).map((m) => m.name),
+    ["a"],
+  );
+  assert.deepEqual(
+    mod.selectMemos(memos, new URLSearchParams("tag=%20Release%20")).map((m) => m.name),
+    ["a"],
+  );
+});
+
+test("summarizeMemo handles query at start and end of content", () => {
+  const startContent = "Release notes at start";
+  const startSummary = mod.summarizeMemo({ content: startContent, snippet: "" }, "release");
+  assert.ok(startSummary.includes("Release"));
+  assert.ok(!startSummary.startsWith("…"));
+
+  const endContent = "This is a release";
+  const endSummary = mod.summarizeMemo({ content: endContent, snippet: "" }, "release");
+  assert.ok(endSummary.includes("release"));
+  assert.ok(!endSummary.endsWith("…"));
+});
