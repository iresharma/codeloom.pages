+}
+export function selectMemos(memos: Memo[], params: URLSearchParams): Memo[] {
+  const query = (params.get("q") ?? "").trim();
+  const tag = (params.get("tag") ?? "").trim();
+  return memos.filter((memo) => {
+    if (query && !(memo.content ?? "").toLowerCase().includes(query.toLowerCase())) return false;
+    if (tag && !(memo.tags ?? []).some((entry) => entry.toLowerCase() === tag.toLowerCase())) return false;
+    return true;
+  });
+}
+
+export function summarizeMemo(memo: Memo, query: string): string {
+  const content = memo.content ?? "";
+  if (!query) {
+    const source = memo.snippet || content;
+    return truncate(source, 200);
+  }
+  const index = content.toLowerCase().indexOf(query.toLowerCase());
+  if (index === -1) return truncate(content, 200);
+  const before = 40;
+  const after = 60;
+  const start = Math.max(0, index - before);
+  const end = Math.min(content.length, index + query.length + after);
+  let result = content.slice(start, end);
+  if (start > 0) result = "…" + result;
+  if (end < content.length) result = result + "…";
+  return result;
+}
+
+function truncate(text: string, limit: number): string {
+  if (text.length <= limit) return text;
+  return text.slice(0, limit) + "…";
 }
-export function selectMemos(memos: Memo[], _params: URLSearchParams): Memo[] { return memos; }
