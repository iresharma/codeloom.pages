+/* global URL URLSearchParams Response */
+import assert from "node:assert/strict";
+import { resolve } from "node:path";
+import test from "node:test";
+import { createServer } from "vite";
+
+const root = new URL("../../", import.meta.url).pathname;
+
+const server = await createServer({
+  root,
+  appType: "custom",
+  configFile: false,
+  logLevel: "silent",
+  resolve: {
+    alias: {
+      "@/": `${resolve(root, "src")}/`,
+    },
+  },
+  server: {
+    middlewareMode: true,
+  },
+});
+
+const { loadReaderMemos, MemoNotFoundError, normalizeMemoName } = await server.ssrLoadModule("/src/lib/reader.ts");
+
+test("normalizeMemoName accepts a bare uid and a full memos/uid", () => {
+  assert.equal(normalizeMemoName("alpha"), "memos/alpha");
+  assert.equal(normalizeMemoName("memos/alpha"), "memos/alpha");
+  assert.equal(normalizeMemoName("memos/abc-123_XYZ"), "memos/abc-123_XYZ");
+});
+
+test("normalizeMemoName rejects empty, malformed, and traversal values", () => {
+  const invalidValues = [
+    "",
+    "users/1",
+    "memos/../x",
+    "memos/alpha/../..",
+    "memos/alpha/..",
+    "memos//alpha",
+    "memos/alpha/",
+    "memos/..",
+    "alpha/.hidden",
+    "a/b",
+    "memos/alpha with space",
+    "memos/\u0000alpha",
+    "\u0000",
+  ];
+  for (const value of invalidValues) {
+    assert.equal(normalizeMemoName(value), null, `expected ${JSON.stringify(value)} to be invalid`);
+  }
+});
+
+test("loadReaderMemos uses the feed when memo is absent", async () => {
+  const feedRequestedUrls = [];
+  globalThis.fetch = async (url) => {
+    feedRequestedUrls.push(String(url));
+    return new Response(JSON.stringify({ memos: [] }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  };
+
+  const feedResultMemos = await loadReaderMemos(new URLSearchParams());
+
+  assert.deepEqual(feedRequestedUrls, ["/api/v1/memos?pageSize=100"]);
+  assert.deepEqual(feedResultMemos, []);
+});
+
+test("loadReaderMemos fetches and parses a single bare Memo", async () => {
+  let singleRequestedUrl = "";
+  globalThis.fetch = async (url) => {
+    singleRequestedUrl = String(url);
+    return new Response(
+      JSON.stringify({
+        name: "memos/alpha",
+        creator: "users/1",
+        displayTime: "2023-11-14T22:13:20Z",
+        content: "",
+        nodes: [],
+        resources: [],
+      }),
+      {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      },
+    );
+  };
+
+  const singleResultMemos = await loadReaderMemos(new URLSearchParams("memo=alpha"));
+
+  assert.equal(singleRequestedUrl, "/api/v1/memos/alpha");
+  assert.equal(singleResultMemos.length, 1);
+  assert.equal(singleResultMemos[0].name, "memos/alpha");
+  assert.equal(singleResultMemos[0].creator, "users/1");
+  assert.ok(singleResultMemos[0].displayTime instanceof Date);
+});
+
+test("loadReaderMemos throws MemoNotFoundError on 404", async () => {
+  globalThis.fetch = async () => new Response("", { status: 404 });
+
+  await assert.rejects(
+    () => loadReaderMemos(new URLSearchParams("memo=missing")),
+    (error) => error instanceof MemoNotFoundError && error.message === "Memo not found",
+  );
+});
+
+test("loadReaderMemos throws MemoNotFoundError on invalid memo without requesting", async () => {
+  let invalidMemoRequested = false;
+  globalThis.fetch = async () => {
+    invalidMemoRequested = true;
+    return new Response("", { status: 200 });
+  };
+
+  await assert.rejects(
+    () => loadReaderMemos(new URLSearchParams("memo=memos/../x")),
+    (error) => error instanceof MemoNotFoundError,
+  );
+  assert.equal(invalidMemoRequested, false);
+});
+
+test("loadReaderMemos throws Error 'Memos unavailable' on non-ok non-404 response", async () => {
+  globalThis.fetch = async () => new Response("", { status: 500 });
+
+  await assert.rejects(
+    () => loadReaderMemos(new URLSearchParams("memo=alpha")),
+    (error) => error instanceof Error && error.message === "Memos unavailable" && !(error instanceof MemoNotFoundError),
+  );
+});
+
+test("loadReaderMemos throws Error 'Memos unavailable' on network failure", async () => {
+  globalThis.fetch = async () => {
+    throw new TypeError("Network error");
+  };
+
+  await assert.rejects(
+    () => loadReaderMemos(new URLSearchParams("memo=alpha")),
+    (error) => error instanceof Error && error.message === "Memos unavailable" && !(error instanceof MemoNotFoundError),
+  );
+});
+
+test("loadReaderMemos accepts full memos/uid format", async () => {
+  let requestedUrl = "";
+  globalThis.fetch = async (url) => {
+    requestedUrl = String(url);
+    return new Response(
+      JSON.stringify({
+        name: "memos/beta",
+        creator: "users/1",
+        displayTime: "2023-11-14T22:13:30Z",
+        content: "",
+        nodes: [],
+        resources: [],
+      }),
+      {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      },
+    );
+  };
+
+  const betaResult = await loadReaderMemos(new URLSearchParams("memo=memos/beta"));
+
+  assert.equal(requestedUrl, "/api/v1/memos/beta");
+  assert.equal(betaResult.length, 1);
+  assert.equal(betaResult[0].name, "memos/beta");
+});
+
+test("loadReaderMemos with null memo returns feed (no memo param)", async () => {
+  const feedUrls = [];
+  globalThis.fetch = async (url) => {
+    feedUrls.push(String(url));
+    return new Response(
+      JSON.stringify({
+        memos: [
+          {
+            name: "memos/alpha",
+            creator: "users/1",
+            displayTime: "2023-11-14T22:13:20Z",
+            content: "",
+            nodes: [],
+            resources: [],
+          },
+        ],
+      }),
+      {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      },
+    );
+  };
+
+  const feedResult = await loadReaderMemos(new URLSearchParams());
+
+  assert.deepEqual(feedUrls, ["/api/v1/memos?pageSize=100"]);
+  assert.equal(feedResult.length, 1);
+  assert.equal(feedResult[0].name, "memos/alpha");
+});
+
+await server.close();
