 import { Memo } from "@/types/proto/api/v1/memo_service";
+
 export async function loadMemos(): Promise<Memo[]> {
   const response = await fetch("/api/v1/memos?pageSize=100");
   if (!response.ok) throw new Error("Memos unavailable");
   const data = await response.json();
-  return (data.memos || []).map((memo: unknown) => Memo.fromPartial({ ...(memo as Memo), displayTime: (memo as Memo).displayTime ? new Date(String((memo as Memo).displayTime)) : undefined }));
+  return (data.memos || []).map((memo: unknown) =>
+    Memo.fromPartial({
+      ...(memo as Memo),
+      displayTime: (memo as Memo).displayTime ? new Date(String((memo as Memo).displayTime)) : undefined,
+    }),
+  );
+}
+
+export function selectMemos(memos: Memo[], _params: URLSearchParams): Memo[] {
+  void _params;
+  return memos;
+}
+
+export class MemoNotFoundError extends Error {
+  constructor() {
+    super("Memo not found");
+    this.name = "MemoNotFoundError";
+  }
+}
+
+const MEMO_UID_PATTERN = /^[A-Za-z0-9_-]+$/;
+
+export function normalizeMemoName(value: string): string | null {
+  if (value.includes("\0")) {
+    return null;
+  }
+  const uid = value.startsWith("memos/") ? value.slice("memos/".length) : value;
+  if (!MEMO_UID_PATTERN.test(uid)) {
+    return null;
+  }
+  return `memos/${uid}`;
+}
+
+export async function loadMemo(name: string): Promise<Memo[]> {
+  try {
+    const response = await fetch(`/api/v1/${name}`);
+    if (response.status === 404) {
+      throw new MemoNotFoundError();
+    }
+    if (!response.ok) {
+      throw new Error("Memos unavailable");
+    }
+    const memo: unknown = await response.json();
+    return [
+      Memo.fromPartial({
+        ...(memo as Memo),
+        displayTime: (memo as Memo).displayTime ? new Date(String((memo as Memo).displayTime)) : undefined,
+      }),
+    ];
+  } catch (error) {
+    if (error instanceof MemoNotFoundError) {
+      throw error;
+    }
+    throw new Error("Memos unavailable");
+  }
+}
+
+export async function loadReaderMemos(params: URLSearchParams): Promise<Memo[]> {
+  const memo = params.get("memo");
+  if (memo === null) {
+    return loadMemos();
+  }
+  const normalized = normalizeMemoName(memo);
+  if (!normalized) {
+    throw new MemoNotFoundError();
+  }
+  return loadMemo(normalized);
 }
-export function selectMemos(memos: Memo[], _params: URLSearchParams): Memo[] { return memos; }
