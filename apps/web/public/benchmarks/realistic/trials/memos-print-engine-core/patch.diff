 .memo-reader { padding: 24px; }
 .reader-feed { display: grid; gap: 20px; }
 .reader-feed article { padding: 16px; border: 1px solid #bbb; }
+
+@media print {
+  .memo-reader {
+    color: #000;
+    background: #fff;
+    padding: 12px;
+  }
+
+  .reader-toolbar {
+    display: none !important;
+  }
+
+  .reader-feed {
+    display: block !important;
+    gap: 0 !important;
+    color: #000 !important;
+    background: transparent !important;
+    text-shadow: none !important;
+    box-shadow: none !important;
+  }
+
+  .reader-feed * {
+    color: #000 !important;
+    background: transparent !important;
+    text-shadow: none !important;
+    box-shadow: none !important;
+  }
+
+  .reader-feed article {
+    border: none !important;
+    box-shadow: none !important;
+    break-inside: avoid;
+    page-break-inside: avoid;
+    margin-bottom: 16px;
+    padding-bottom: 16px;
+    overflow-wrap: anywhere;
+  }
+
+  .reader-feed table {
+    border-collapse: collapse;
+    width: 100% !important;
+    max-width: 100%;
+    border: 1px solid #333 !important;
+  }
+
+  .reader-feed th,
+  .reader-feed td {
+    border: 1px solid #333 !important;
+    padding: 4px 8px;
+    text-align: left;
+    white-space: normal;
+    overflow-wrap: anywhere;
+  }
+
+  .reader-feed pre,
+  .reader-feed code {
+    white-space: pre-wrap !important;
+    overflow-wrap: anywhere;
+  }
+
+  .reader-feed pre {
+    max-width: 100% !important;
+    overflow: visible !important;
+  }
+
+  .reader-feed .overflow-auto {
+    overflow: visible !important;
+  }
+
+  .reader-feed img {
+    max-width: 100% !important;
+    height: auto;
+  }
+
+  .reader-feed a {
+    overflow-wrap: anywhere;
+  }
+
+  .reader-feed blockquote {
+    border-inline-start: 4px solid #999 !important;
+  }
+
+  .reader-feed h1,
+  .reader-feed h2,
+  .reader-feed h3,
+  .reader-feed h4,
+  .reader-feed h5,
+  .reader-feed h6 {
+    break-after: avoid;
+    page-break-after: avoid;
+  }
+
+  .reader-meta,
+  .reader-attachments {
+    break-inside: avoid;
+    page-break-inside: avoid;
+  }
+
+  .reader-attachments a {
+    word-break: break-all;
+  }
+}
