@@ -1,3 +1,57 @@
 .memo-reader { padding: 24px; }
-.reader-feed { display: grid; gap: 20px; }
-.reader-feed article { padding: 16px; border: 1px solid #bbb; }
+
+.reader-feed {
+  display: grid;
+  gap: 20px;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.reader-feed article {
+  min-width: 0;
+  padding: 16px;
+  border: 1px solid #bbb;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+}
+
+.reader-meta {
+  min-width: 0;
+  margin: 0 0 12px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+}
+
+.reader-attachments {
+  max-width: 100%;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+}
+
+.reader-attachments a {
+  max-width: 100%;
+  min-width: 0;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+}
+
+.reader-feed article img {
+  max-width: 100%;
+  height: auto;
+}
+
+.reader-feed article .memo-content-scroll {
+  max-width: 100%;
+  overflow-x: auto;
+  display: block;
+}
+
+@media (min-width: 1024px) {
+  .reader-feed {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
