+++ b/var/folders/nh/3vkz2yfd54z0xkpd_47b2qwh0000gn/T/tmp9kqu1gzr/patch/web/src/components/MemoContent/reader.responsive.test.mjs
@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+
+// Regression test for the /reader responsive feed. The mjs test keeps the
+// reader CSS and the two memo-content wrappers in lockstep without adding a
+// frontend test dependency to the repo.
+const here = dirname(fileURLToPath(import.meta.url));
+const read = (file) => readFileSync(join(here, file), "utf8");
+
+const codeBlockSource = read("CodeBlock.tsx");
+const tableSource = read("Table.tsx");
+const readerCss = read("../../css/reader.css");
+
+test("code block wraps its pre in the reader-scoped scroll container", () => {
+  assert.match(
+    codeBlockSource,
+    /<div className="memo-content-scroll w-full overflow-auto">\s*<pre[\s\S]*?<\/pre>\s*<\/div>/,
+    "CodeBlock.tsx should keep the pre inside .memo-content-scroll",
+  );
+});
+
+test("table wraps the table in the reader-scoped scroll container", () => {
+  assert.match(
+    tableSource,
+    /<div className="memo-content-scroll w-full overflow-x-auto">\s*<table[\s\S]*?<\/table>\s*<\/div>/,
+    "Table.tsx should keep the table inside .memo-content-scroll",
+  );
+});
+
+test("reader css provides the responsive grid and containment rules", () => {
+  const requiredCss = [
+    "grid-template-columns: minmax(0, 1fr);",
+    "min-width: 0;",
+    "overflow-wrap: anywhere;",
+    "word-break: break-word;",
+    ".reader-attachments a {",
+    ".reader-feed article img {",
+    ".reader-feed article .memo-content-scroll {",
+    "max-width: 100%;",
+    "overflow-x: auto;",
+    "display: block;",
+    "@media (min-width: 1024px)",
+    "repeat(2, minmax(0, 1fr));",
+  ];
+  for (const snippet of requiredCss) {
+    assert.ok(readerCss.includes(snippet), `reader.css should contain: ${snippet}`);
+  }
+});
