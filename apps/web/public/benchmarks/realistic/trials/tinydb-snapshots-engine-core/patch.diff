+import json
+
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage, MemoryStorage
+from tinydb.table import Document
+
+
+def test_export_json_empty_database():
+    db = TinyDB(storage=MemoryStorage)
+
+    assert json.loads(db.export_json()) == {}
+
+
+def test_export_json_preserves_tables_and_doc_ids():
+    db = TinyDB(storage=MemoryStorage)
+
+    db.insert({'a': 1})
+    db.table('users').insert({'b': 2})
+
+    assert json.loads(db.export_json()) == {
+        '_default': {'1': {'a': 1}},
+        'users': {'1': {'b': 2}},
+    }
+
+
+def test_export_json_preserves_negative_doc_id():
+    db = TinyDB(storage=MemoryStorage)
+
+    db.insert(Document({'a': 1}, -5))
+
+    assert json.loads(db.export_json()) == {
+        '_default': {'-5': {'a': 1}},
+    }
+
+
+def test_import_json_round_trip():
+    db1 = TinyDB(storage=MemoryStorage)
+    db1.insert({'a': 1})
+    db1.table('users').insert({'b': 2})
+
+    db2 = TinyDB(storage=MemoryStorage)
+    db2.import_json(db1.export_json())
+
+    assert db2.tables() == db1.tables()
+    assert db2.storage.read() == db1.storage.read()
+    assert [document.doc_id for document in db2.all()] == [
+        document.doc_id for document in db1.all()
+    ]
+
+
+def test_export_json_is_independent_of_later_mutations():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+
+    exported = db.export_json()
+
+    db.insert({'b': 2})
+    db.table('users').insert({'c': 3})
+
+    assert json.loads(exported) == {
+        '_default': {'1': {'a': 1}},
+    }
+
+
+def test_import_json_replaces_existing_data():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'old': True})
+    db.table('old_table').insert({'old': True})
+
+    db.import_json('{"new_table": {"1": {"new": true}}}')
+
+    assert db.tables() == {'new_table'}
+    assert db.storage.read() == {
+        'new_table': {'1': {'new': True}},
+    }
+    assert db.all() == []
+
+
+def test_import_json_resets_existing_table_caches_and_next_id():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('foo')
+    table.insert({'x': 1})
+    table.search(where('x') == 1)
+
+    assert table._next_id is not None
+    assert len(table._query_cache) == 1
+
+    db.import_json('{"foo": {"1": {"x": 1}, "2": {"x": 2}}}')
+
+    assert table._next_id is None
+    assert len(table._query_cache) == 0
+    assert [document.doc_id for document in table.all()] == [1, 2]
+    assert table.insert({'x': 3}) == 3
+
+
+def test_import_json_resets_default_table_next_id():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'old': True})
+
+    db.import_json('{"_default": {"5": {"x": 1}}}')
+
+    assert db.insert({'y': 2}) == 6
+
+
+def test_import_json_rejects_non_string_text():
+    db = TinyDB(storage=MemoryStorage)
+    db.import_json('{"keep": {"1": {"k": true}}}')
+    before = db.storage.read()
+
+    for non_str in (123, [], {}, None, b'bytes'):
+        with pytest.raises(ValueError):
+            db.import_json(non_str)
+        assert db.storage.read() == before
+
+
+def test_import_json_rejects_non_object_json():
+    db = TinyDB(storage=MemoryStorage)
+    db.import_json('{"keep": {"1": {"k": true}}}')
+    before = db.storage.read()
+
+    for text in ('123', '[]', '"str"'):
+        with pytest.raises(ValueError):
+            db.import_json(text)
+        assert db.storage.read() == before
+
+
+def test_import_json_rejects_invalid_structure_before_write():
+    invalid_payloads = [
+        '{"t": []}',
+        '{"t": {"0": {"a": 1}}}',
+        '{"t": {"-1": {"a": 1}}}',
+        '{"t": {"01": {"a": 1}}}',
+        '{"t": {"abc": {"a": 1}}}',
+        '{"t": {"1": 42}}',
+    ]
+
+    for text in invalid_payloads:
+        db = TinyDB(storage=MemoryStorage)
+        db.import_json('{"old": {"1": {"keep": 1}}}')
+        before = db.storage.read()
+
+        with pytest.raises(ValueError):
+            db.import_json(text)
+
+        assert db.storage.read() == before
+
+
+def test_import_json_rejects_malformed_json():
+    db = TinyDB(storage=MemoryStorage)
+    db.import_json('{"old": {"1": {"keep": 1}}}')
+    before = db.storage.read()
+
+    with pytest.raises(ValueError):
+        db.import_json('{"missing": ')
+
+    assert db.storage.read() == before
+
+
+class _FailingMemoryStorage(MemoryStorage):
+    def __init__(self):
+        super().__init__()
+        self.fail_next_write = False
+
+    def write(self, data):
+        if self.fail_next_write:
+            raise IOError('write failed')
+        super().write(data)
+
+
+def test_import_json_failed_write_keeps_existing_caches():
+    storage = _FailingMemoryStorage()
+    db = TinyDB(storage=lambda: storage)
+    db.insert({'x': 1})
+    db.search(where('x') == 1)
+
+    table = db._tables['_default']
+    assert len(table._query_cache) == 1
+
+    storage.fail_next_write = True
+
+    with pytest.raises(IOError):
+        db.import_json('{"other": {"1": {"y": 2}}}')
+
+    assert len(table._query_cache) == 1
